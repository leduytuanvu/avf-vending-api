{
  "$schema": "https://repomix.com/schemas/repomix.schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true
  },
  "include": [],
  "ignore": {
    "customPatterns": [
      ".git/**",
      "vendor/**",
      "node_modules/**",
      ".e2e-runs/**",
      ".test-runs/**",
      "coverage/**",
      "dist/**",
      "build/**",
      "bin/**",
      "gen/**",
      "tmp/**",
      "temp/**",
      ".cache/**",
      "__pycache__/**",
      "**/*.log",
      "**/*.tmp",
      "**/*.bak",
      "**/*.old",
      "**/*.orig",
      ".tmp-*/**",
      ".tmp-*",
      "repomix-output.xml",
      "ci-reports/**",
      "security-reports/**",
      "deployments/prod/.deploy/**",
      "deployments/prod/backups/**",
      "postman/**/newman/**",
      "postman/reports/**",
      "postman/**/*.zip",
      "**/newman-report.json",
      "**/newman-junit.xml",
      "manual-import-parity-newman-report.json",
      ".go-tmp/**",
      ".bin/**",
      "*.exe",
      "*.test",
      "*.sql.gz",
      "*.dump",
      "backups/**",
      "db-backups/**"
    ]
  }
}
