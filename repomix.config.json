{
  "$schema": "https://repomix.com/schemas/repomix.schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true
  },
  "include": [],
  "ignore": {
    "customPatterns": [
      ".git/**",
      "vendor/**",
      "node_modules/**",
      ".e2e-runs/**",
      ".production-smoke-runs/**",
      ".production-latency-runs/**",
      ".test-runs/**",
      "coverage/**",
      "coverage.out",
      "dist/**",
      "build/reports/**",
      "bin/**",
      "gen/**",
      "tmp/**",
      "temp/**",
      ".cache/**",
      "__pycache__/**",
      "**/*.log",
      "logs/**",
      "**/*.tmp",
      "**/*.bak",
      "**/*.old",
      "**/*.orig",
      ".tmp-*/**",
      ".tmp-*",
      ".repomix/**",
      "repomix-output.xml",
      "repomix-output*.xml",
      "ci-reports/**",
      "security-reports/**",
      "deployments/prod/.deploy/**",
      "deployments/prod/backups/**",
      "postman/**/newman/**",
      "postman/reports/**",
      "postman/**/*.zip",
      "**/newman-report.json",
      "**/newman-junit.xml",
      "manual-import-parity-newman-report.json",
      "postman/**/*.postman_collection.json",
      "postman/generated/API_INVENTORY_CANONICAL.json",
      ".go-tmp/**",
      ".bin/**",
      "*.exe",
      "*.test",
      "*.sql.gz",
      "*.dump",
      "backups/**",
      "db-backups/**",
      "docs/testing/production-e2e/RESULTS_*.md",
      "docs/testing/production-e2e/API_TRACE_*.md",
      "docs/testing/production-e2e/POSTMAN_*_*.md",
      "docs/testing/production-e2e/MANUAL_RETEST_GUIDE_*.md",
      "docs/reports/test/mqtt-full-coverage.json",
      "docs/reports/test/mqtt-full-coverage.md"
    ]
  }
}
