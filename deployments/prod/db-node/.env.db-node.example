COMPOSE_PROJECT_NAME=avf-vending-prod-db
POSTGRES_USER=avf
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
POSTGRES_DB=avf_vending_prod
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
POSTGRES_BIND_IP=127.0.0.1
# After app-node-b is ready, set PGBOUNCER_BIND_IP=0.0.0.0 and UFW-allow only 187.127.99.153.
PGBOUNCER_BIND_IP=127.0.0.1
# Also allow VPS B (app-node-b) via UFW, not by binding 0.0.0.0 unless you must.
# POSTGRES_BIND_IP=0.0.0.0
POSTGRES_MEMORY_LIMIT=1536M
POSTGRES_CPUS=1.0
# Runtime DATABASE_URL for both app nodes (production rejects localhost).
# Include simple_protocol for pgx + PgBouncer transaction pooling:
# DATABASE_URL=postgres://avf:PASSWORD@72.62.244.94:6432/avf_vending_prod?sslmode=disable&default_query_exec_mode=simple_protocol
# Host-side backups on VPS A (direct Postgres, not used by API containers):
# BACKUP_DATABASE_URL=postgres://avf:PASSWORD@127.0.0.1:5432/avf_vending_prod?sslmode=disable
