# Sample Caddy site for machine gRPC behind TLS at machine-api.<domain>.
# Integrated into deployments/prod/shared/Caddyfile as the {$MACHINE_GRPC_DOMAIN} vhost.
# TLS terminates at Caddy; upstream speaks h2c on the Docker internal network (GRPC_BEHIND_TLS_PROXY=true on api).
#
# Align MACHINE_GRPC_DOMAIN and GRPC_PUBLIC_BASE_URL with the same hostname.

machine-api.example.com {
	tls /etc/ssl/machine-api/fullchain.pem /etc/ssl/machine-api/privkey.pem

	reverse_proxy h2c://api:9090 {
		transport http {
			versions h2c
		}
	}
}
