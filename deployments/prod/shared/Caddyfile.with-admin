{
	admin off
	email {$CADDY_ACME_EMAIL}

	servers {
		protocols h1 h2 h3
		timeouts {
			read_body 15s
			read_header 10s
			write 75s
			idle 120s
		}
	}
}

(app_https) {
	# Android 7.x (API 24–25) field boards need TLS 1.2; keep 1.2 enabled. Cipher list left to
	# Caddy defaults so legacy ClientHello negotiation is not rejected by an overly narrow set.
	tls {
		protocols tls1.2 tls1.3
	}
	encode gzip zstd
	request_body {
		max_size {$CADDY_MAX_REQUEST_BODY:25MB}
	}
	log {
		output stdout
		format console
	}
	reverse_proxy {$UPSTREAM_API} {
		flush_interval -1
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {http.request.remote.host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 75s
			write_timeout 75s
		}
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
	}
}

# Machine runtime gRPC: TLS terminates here; cleartext h2c to api:9090 (GRPC_BEHIND_TLS_PROXY=true).
# Do not gzip-encode this vhost — gRPC uses HTTP/2 binary frames.
(machine_grpc_https) {
	log {
		output stdout
		format console
	}
	reverse_proxy {$UPSTREAM_GRPC} {
		transport http {
			versions h2c
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 75s
			write_timeout 75s
		}
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
	}
}

(admin_web_https) {
	tls {
		protocols tls1.2 tls1.3
	}
	encode gzip zstd
	log {
		output stdout
		format console
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
	}
	@nextStatic path /_next/static/*
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"
	@private path /api/* /login* /dashboard* /machines* /sites* /catalog* /inventory* /planograms* /orders* /payments* /cash* /reports* /telemetry* /commands* /alerts* /audit* /users* /settings*
	header @private Cache-Control "no-store"
	reverse_proxy {$UPSTREAM_WEB:avf-vending-web:3000} {
		flush_interval -1
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {http.request.remote.host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 75s
			write_timeout 75s
		}
	}
}

{$API_DOMAIN} {
	import app_https
}

{$MACHINE_GRPC_DOMAIN} {
	import machine_grpc_https
}

{$ADMIN_DOMAIN:admin.ldtv.dev} {
	import admin_web_https
}
