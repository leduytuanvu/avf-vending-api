# EMQX base configuration for the split production topology.
# External/public MQTT is TLS-first on 8883.
# Plain MQTT on 1883 exists only for private-network or local-node compatibility and must not be exposed publicly.

listeners.tcp.default {
  enable = true
  bind = "127.0.0.1:1883"
}

listeners.ssl.default {
  enable = true
  bind = "0.0.0.0:8883"
  ssl_options {
    cacertfile = "/opt/emqx/etc/certs/ca.crt"
    certfile = "/opt/emqx/etc/certs/server.crt"
    keyfile = "/opt/emqx/etc/certs/server.key"
    # Server-auth TLS today; switch to verify_peer + fail_if_no_peer_cert=true
    # when machine client certificates are issued fleet-wide.
    verify = verify_none
    fail_if_no_peer_cert = false
  }
}

# Per-machine topic ACL: acl.conf is mounted read-only; enable only after the file exists on disk.
authorization {
  enable = true
  no_match = deny
  deny_action = disconnect
  cache {
    enable = true
    max_size = 32
    ttl = "1m"
  }
  sources = [
    {
      type = file
      enable = true
      path = "/opt/emqx/etc/acl.conf"
    }
  ]
}
