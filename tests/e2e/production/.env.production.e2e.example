# Tracked template — copy to .env.production.e2e.local (gitignored) and fill secrets.
# GitHub Actions: map E2E_PROD_* repository secrets (see e2e-manifest.yaml env.github_secrets).

BASE_URL=https://api.ldtv.dev
E2E_TARGET=production
E2E_ALLOW_WRITES=true
E2E_PRODUCTION_WRITE_CONFIRMATION=I_UNDERSTAND_THIS_WRITES_TO_PRODUCTION

# Operator credentials (never commit)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Or pre-issued token:
ADMIN_TOKEN=

# Machine path populated by harness when running live
MACHINE_ID=
MACHINE_TOKEN=

GRPC_ADDR=api.ldtv.dev:443
GRPC_USE_REFLECTION=false
GRPC_PROTO_ROOT=proto

MQTT_HOST=mqtt.ldtv.dev
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_TOPIC_PREFIX=avf/prod
MQTT_USERNAME=
MQTT_PASSWORD=

# Webhook signing for commerce flows (or set E2E_PROD_PAYMENT_WEBHOOK_SECRET in CI)
COMMERCE_PAYMENT_WEBHOOK_SECRET=

# Media fixture sha256 for 1x1 PNG in fixtures/test-product.png
PROD_E2E_MEDIA_SHA256=c414cd0e204de974f73753c7e28d7638e7b3691bb8b1a2bab6b25bb7fed7ce77
