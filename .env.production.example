# Production (operator): wire DATABASE_URL / REDIS / NATS / MQTT / OBJECT_STORAGE_* / JWT / PAYMENT_* in the VPS
# `.env` — not in GitHub Actions as bare `DATABASE_URL`.
# Substitution variables below illustrate secret-store naming; authoritative examples live under deployments/prod/.
APP_ENV=production
# Vending machine apps: gRPC + Machine JWT. Legacy machine REST is off in prod unless intentionally enabled.
ENABLE_LEGACY_MACHINE_HTTP=false
DATABASE_URL=${PRODUCTION_DATABASE_URL}
REDIS_URL=${PRODUCTION_REDIS_URL}
NATS_URL=${PRODUCTION_NATS_URL}
MQTT_BROKER_URL=${PRODUCTION_MQTT_BROKER_URL}
MQTT_TOPIC_PREFIX=avf/devices
PUBLIC_BASE_URL=https://api.ldtv.dev
# OpenAPI / Swagger: production defaults fail-closed for /swagger/doc.json (unset HTTP_OPENAPI_JSON_ENABLED → off).
HTTP_SWAGGER_UI_ENABLED=false
HTTP_OPENAPI_JSON_ENABLED=false
PRODUCTION_OPENAPI_JSON_ALLOWED=false
# To expose OpenAPI JSON only for Postman (no Swagger UI):
# HTTP_OPENAPI_JSON_ENABLED=true
# PRODUCTION_OPENAPI_JSON_ALLOWED=true
# HTTP_SWAGGER_UI_ENABLED=false
#
# Metrics: scrape via HTTP_OPS_ADDR; keep public /metrics off.
METRICS_ENABLED=true
METRICS_EXPOSE_ON_PUBLIC_HTTP=false
HTTP_OPS_ADDR=0.0.0.0:8081
# METRICS_SCRAPE_TOKEN=<long-random-token>
PAYMENT_ENV=cash_only
# Explicit cash-only production pilot: QR/card sessions disabled; do not set COMMERCE_PAYMENT_PROVIDER.
# When wiring a real live PSP, set PAYMENT_ENV=live and COMMERCE_PAYMENT_PROVIDER to a WiredLiveProvider key (not stripe/momo/zalopay/vnpay placeholders).
# COMMERCE_PAYMENT_PROVIDER=
READINESS_STRICT=true
DATABASE_MAX_CONNS=40
DATABASE_MIN_CONNS=4
DATABASE_SLOW_QUERY_LOG_MS=200
API_DATABASE_MAX_CONNS=25
API_DATABASE_MIN_CONNS=4
WORKER_DATABASE_MAX_CONNS=8
WORKER_DATABASE_MIN_CONNS=1
MQTT_INGEST_DATABASE_MAX_CONNS=8
MQTT_INGEST_DATABASE_MIN_CONNS=1
RECONCILER_DATABASE_MAX_CONNS=4
RECONCILER_DATABASE_MIN_CONNS=1
TEMPORAL_WORKER_DATABASE_MAX_CONNS=4
TEMPORAL_WORKER_DATABASE_MIN_CONNS=1
REDIS_CACHE_ENABLED=true
REDIS_RATE_LIMIT_ENABLED=true
REDIS_SESSION_CACHE_ENABLED=true
SALE_CATALOG_CACHE_TTL=45s

# --- Product image upload (Cloudinary; optional — no object storage required) ---
MEDIA_PROVIDER=cloudinary
MEDIA_UPLOAD_ENABLED=true
MEDIA_COMPANY_ID=your-stable-media-company-uuid-v7
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=avf-vending/products
MEDIA_MAX_IMAGE_SIZE_MB=5
MEDIA_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
